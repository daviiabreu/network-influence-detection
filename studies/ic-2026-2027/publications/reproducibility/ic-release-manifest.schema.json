{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ic-study:ic-release-manifest:v2",
  "title": "IC release packaging integrity record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "revisions",
    "environments",
    "files",
    "scientific_acceptance",
    "regeneration_performed",
    "scientific_replay_performed",
    "license_decisions"
  ],
  "properties": {
    "schema": {
      "const": "ic-release-manifest-v2"
    },
    "mode": {
      "enum": [
        "source-only",
        "approved-release",
        "synthetic"
      ]
    },
    "revisions": {
      "$ref": "#/$defs/revisions"
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmatory",
        "x3-x7",
        "legacy-x5-x7",
        "shp-code",
        "shp-freeze",
        "v44-successor",
        "release-wrapper",
        "bridge",
        "reporting-export"
      ],
      "properties": {
        "confirmatory": {
          "$ref": "#/$defs/environment"
        },
        "x3-x7": {
          "$ref": "#/$defs/environment"
        },
        "legacy-x5-x7": {
          "$ref": "#/$defs/environment"
        },
        "shp-code": {
          "$ref": "#/$defs/environment"
        },
        "shp-freeze": {
          "$ref": "#/$defs/environment"
        },
        "v44-successor": {
          "$ref": "#/$defs/environment"
        },
        "release-wrapper": {
          "$ref": "#/$defs/environment"
        },
        "bridge": {
          "$ref": "#/$defs/environment"
        },
        "reporting-export": {
          "$ref": "#/$defs/environment"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      },
      "uniqueItems": true
    },
    "scientific_acceptance": {
      "const": false
    },
    "regeneration_performed": {
      "const": false
    },
    "scientific_replay_performed": {
      "const": false
    },
    "license_decisions": {
      "const": "MIT"
    }
  },
  "$defs": {
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmatory",
        "x3-x7",
        "legacy-x5-x7",
        "shp-code",
        "shp-freeze",
        "v44-successor",
        "release-wrapper",
        "bridge",
        "reporting-export"
      ],
      "properties": {
        "confirmatory": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "x3-x7": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "legacy-x5-x7": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "shp-code": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "shp-freeze": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "v44-successor": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release-wrapper": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bridge": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reporting-export": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "lock_sha256",
        "pyproject_sha256",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pyproject_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "frozen_environment": {
          "type": "object"
        }
      }
    },
